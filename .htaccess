# 🛡️ فایل تنظیمات Apache — سایت ساز برند سهند سرویس
# ================================================

# فعال‌سازی موتور بازنویسی آدرس‌ها
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 📌 مسیریابی API داخلی — تمام درخواست‌های /api/* به روتر ارجاع می‌شوند
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]

    # 📌 جلوگیری از دسترسی مستقیم به فایل‌های حساس
    RewriteRule ^(config|config\.local)\.php$ - [F,L]
    RewriteRule ^database\.sql$ - [F,L]
    RewriteRule ^core/ - [F,L]
    RewriteRule ^engine/knowledge/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^cache/ - [F,L]
    RewriteRule ^install\.php$ - [L]

    # 🆕 v2.33 — 🚫 مسدودسازی پوشه .git (جلوگیری از دانلود کل تاریخچه کد)
    # گزارش تحلیل جامع (یافته فوری ۴): تنها پوشه حساس بدون قانون مسدودسازی
    RewriteRule ^\.git - [F,L]
</IfModule>

# ⛔ غیرفعال‌سازی فهرست پوشه‌ها (Directory Listing)
Options -Indexes

# 📌 فایل پیش‌فرض
DirectoryIndex index.php admin/login.php

# 🛡️ هدرهای امنیتی
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # 🆕 v2.33 — 🛡️ سیاست امنیت محتوا (حالت گزارش‌دهی — Report-Only)
    # ابتدا تخلف‌ها در logs/csp.log ثبت می‌شوند؛ پس از پاک‌سازی، به حالت
    # اجرایی (حذف Report-Only) تبدیل شود. frame-ancestors از clickjacking
    # و script-src از تزریق اسکریپت خارجی جلوگیری می‌کند.
    Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' https: http:; media-src 'self' https:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https: http:; frame-ancestors 'self'; report-uri /csp-report.php"

    # 🔓 دسترسی CORS برای سایت‌های برند (فراخوانی API و منابع مشترک)
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|webp|ico)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ⚡ فشرده‌سازی Gzip برای بهبود سرعت
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2 application/font-woff2
</IfModule>

# ⏱️ کش مرورگر برای منابع ایستا
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 🚫 محافظت از فایل htaccess خودش
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# 🆕 v2.33 — 🚫 مستندات داخلی و فایل‌های حساس از وب قابل دسترسی نیستند
# (README/CHANGELOG/WORKLOG/CHECKLIST/BrandMaker/improvement/UPGRADE/Create-Subdomain
#  + database.sql + .user.ini + فایل‌های لاگ — گزارش تحلیل بخش امنیت)
<FilesMatch "\.(md|sql|log|ini|lock|sh)$">
    Require all denied
</FilesMatch>
