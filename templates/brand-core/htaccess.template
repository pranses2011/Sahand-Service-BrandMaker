# ⚙️ تنظیمات Apache سایت برند
# =============================

# 🚫 غیرفعال‌سازی فهرست پوشه‌ها
Options -Indexes

# 📌 فایل پیش‌فرض
DirectoryIndex index.php

# 🔀 URL Rewriting — آدرس‌های تمیز
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 🌍 v2.37 — P3: چندزبانگی — پیشوند /en/ → همان صفحات با BRAND_LANG=en
    #    (فقط ریشه و صفحات اصلی؛ فایل‌های فنی مستثنا هستند)
    RewriteCond %{REQUEST_URI} !^/(sw\.js|manifest\.json|offline\.html|sitemap\.php|feed\.php|robots\.txt|api/|cache/|includes/|css/|js/)
    RewriteRule ^(en)/(services|service-area|warranty|blog|search|about-agency|about-brand|contact|request|other-brands|error-codes|faq|sitemap-page|terms|privacy)/?$ pages/$2.php?lang=en [L,QSA]
    RewriteRule ^en/?$ index.php?lang=en [L,QSA]
    RewriteRule ^en/blog/([^/]+)/?$ pages/article.php?slug=$1&lang=en [L,QSA]

    # خدمات
    RewriteRule ^services/?$ pages/services.php [L]
    # محدوده خدمات
    RewriteRule ^service-area/?$ pages/service-area.php [L]
    # ضمانت
    RewriteRule ^warranty/?$ pages/warranty.php [L]
    # مقالات
    RewriteRule ^blog/?$ pages/blog.php [L]
    # 🔗 v2.34 — URL تمیز مقالات: /blog/{slug} (آدرس قدیمی در PHP با ۳۰۱ هدایت می‌شود)
    RewriteRule ^blog/([^/]+)/?$ pages/article.php?slug=$1 [L,QSA]
    RewriteRule ^blog/article/?$ pages/article.php [L,QSA]
    # 🔍 v2.34 — جستجوی سایت برند
    RewriteRule ^search/?$ pages/search.php [L,QSA]
    # 📡 v2.34 — فید RSS/Atom
    RewriteRule ^feed/?$ feed.php [L,QSA]
    RewriteRule ^rss/?$ feed.php [L,QSA]
    # درباره‌ها
    RewriteRule ^about-agency/?$ pages/about-agency.php [L]
    RewriteRule ^about-brand/?$ pages/about-brand.php [L]
    # تماس
    RewriteRule ^contact/?$ pages/contact.php [L]
    # ثبت درخواست
    RewriteRule ^request/?$ pages/request.php [L]
    # سایر برندها
    RewriteRule ^other-brands/?$ pages/other-brands.php [L]
    # کدهای خطا
    RewriteRule ^error-codes/?$ pages/error-codes.php [L]
    # سوالات متداول
    RewriteRule ^faq/?$ pages/faq.php [L]
    # نقشه سایت HTML
    RewriteRule ^sitemap-page/?$ pages/sitemap-page.php [L]
    # 🗺️ v2.33 — sitemap.xml پویا: همیشه تازه (مقاله جدید بدون استقرار مجدد وارد می‌شود)
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    # قوانین
    RewriteRule ^terms/?$ pages/terms.php [L]
    RewriteRule ^privacy/?$ pages/privacy.php [L]

    # 🚫 جلوگیری از دسترسی مستقیم به فایل‌های حساس
    RewriteRule ^config\.php$ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^cache/ - [F,L]
</IfModule>

# ⛔ صفحه ۴۰۴ سفارشی
ErrorDocument 404 /404.php

# 🛡️ هدرهای امنیتی (یادآوری: کامنت Apache فقط با # است — سینتکس C- مانند در htaccess خطای 500 می‌دهد)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ⚡ فشرده‌سازی و کش
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 year"
    # 📱 v2.37 — P3: Service Worker و مانیفست PWA هرگز کش سروری نمی‌شوند
    #    (مرورگر باید نسخه تازه SW را بگیرد تا به‌روزرسانی فوری شود)
    <FilesMatch "^(sw\.js|manifest\.json)$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# 📱 v2.37 — P3: نوع MIME درست برای مانیفست (برخی هاست‌ها text/plain می‌فرستند و نصب PWA خراب می‌شود)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    <Files "manifest.json">
        ForceType application/json
    </Files>
</IfModule>
